  audioSource: {fileID: 8808718852066995482}
  steps:
  - id: introA
    message: "\u2022 Ameliyat sonras\u0131 hareket etmen \xF6nemli ama yava\u015F
      yava\u015F ba\u015Flamal\u0131s\u0131n. Doktorunun \xF6nerdi\u011Fi hareketleri
      yapmal\u0131s\u0131n \r\n\u2022 Servise ge\xE7ti\u011Finde seni 45 derece yat\u0131racaklar
      \u2014 bu nefes almana yard\u0131mc\u0131 olur!\r\n\u2022 Solunum egzersizi
      yapacaks\u0131n  hem\u015Fire sana g\xF6sterecek.\r\n\u2022 \xD6ks\xFCrmek
      de bir egzersiz! Akci\u011Ferlerini a\xE7\u0131k tutar.\r\n\u2022 Oyun odas\u0131
      \u015Fimdilik yasak \u2014 mikroplardan korunmak i\xE7in!"
    audioClip: {fileID: 8300000, guid: 6f373c3b946f9c5439f52a90d897cc9a, type: 3}
  nurseImage: {fileID: 4634299499983353948}
