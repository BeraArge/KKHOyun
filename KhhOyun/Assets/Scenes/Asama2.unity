    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[0].id
      value: intro
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[1].id
      value: afterB
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[2].id
      value: afterD
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[3].id
      value: afterE
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[0].message
      value: "\u2022 Haz\u0131rl\u0131klar yap\u0131l\u0131r.\r\n\u2022 Ameliyathaneye
        g\xF6t\xFCr\xFCleceksin ve \xF6nl\xFCk giyeceksin.\r\n\u2022 Ameliyata girece\u011Fin
        kap\u0131ya kadar ailen yan\u0131nda olacak. O noktadan sonra sa\u011Fl\u0131k
        \xE7al\u0131\u015Fanlar\u0131 sana e\u015Flik edecek \u2014 ailen kap\u0131da
        bekleyecek. Ama merak etme, ameliyat bitince seni g\xF6rmek i\xE7in bekleme
        salonunda olacaklar!\r\n\u2022 Premedikasyon (sakinle\u015Ftirici bir ila\xE7)
        verilecek, bu seni rahatlat\u0131r.\r\n\u2022 Uyutulacaks\u0131n ve hi\xE7bir
        \u015Fey hissetmeyeceksin."
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[1].message
      value: "\u2022 Ameliyathane \xF6zel bir yerdir.\r\n\u2022 Doktorlar \xF6zel
        k\u0131yafetler giyer.\r\n\u2022 Seni uyuturlar, ameliyat s\u0131ras\u0131nda
        hi\xE7bir \u015Fey hissetmezsin."
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[2].message
      value: "\u2022 Ameliyattan uyand\u0131\u011F\u0131nda etraf biraz g\xFCr\xFClt\xFCl\xFC
        ve kalabal\u0131k olabilir \u2014 bu normal!\r\n\u2022 \xDCzerinde t\xFCpler
        ve cihazlar olabilir, onlar seni iyile\u015Ftiriyor.\r\n\u2022 Uyand\u0131\u011F\u0131nda
        bir solunum t\xFCp\xFC (ent\xFCbasyon) olabilir \u2014 doktorlar uygun g\xF6rd\xFCklerinde
        h\u0131zl\u0131ca \xE7\u0131karacaklar (genellikle 1-2 saat i\xE7inde).\r\n\u2022
        Kolunda veya baca\u011F\u0131nda ince bir hortum (kateter/arter hatt\u0131)
        olacak \u2014 bu doktorlar\u0131n seni takip etmesini sa\u011Flar, dokunma!\r\n\u2022
        \u0130drar t\xFCp\xFC (foley kateter) ve g\xF6\u011Fs\xFCndeki dren t\xFCp\xFC
        de olacak \u2014 bunlar iyile\u015Fmene yard\u0131mc\u0131 oluyor.\r\n\u2022
        \xD6ks\xFCrme egzersizi yapacaks\u0131n\r\n\u2022 Yatak i\xE7erisinde hareket
        edeceksin. \r\n\u2022 Aileni Pazartesi, \xC7ar\u015Famba ve Cuma g\xFCnleri
        k\u0131sa s\xFCreli\u011Fine g\xF6rebileceksin \u2014 ama her zaman doktorlar
        yan\u0131nda olacak!"
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[3].message
      value: "\u2022Solunum egzersizleri yapacaks\u0131n (triflow g\xF6r\xFCnt\xFCs\xFC
        olacak)\r\n\u2022V\xFCcudundaki ba\u011Flant\u0131lardan ayr\u0131lacaks\u0131n.\r\n\u2022
        Yava\u015F yava\u015F aya\u011Fa kalkacaks\u0131n.\r\n\u2022A\u011F\u0131zdan
        beslenmeye ba\u015Flanacaks\u0131n, ilk \xF6nce su gibi s\u0131v\u0131lar
        sonra \xE7orbalar\u0131 yemeye ba\u015Flayacaks\u0131n."
      objectReference: {fileID: 0}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[0].audioClip
      value: 
      objectReference: {fileID: 8300000, guid: 59526bc64e9227349a02caa86ea76011, type: 3}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
