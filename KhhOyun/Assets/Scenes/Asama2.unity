      objectReference: {fileID: 8300000, guid: f9ac874585c4e4b4ebdc7a7339acff8c, type: 3}
    - target: {fileID: 5899709560390685702, guid: 861261748c481be44a4502bd2dffbf9e, type: 3}
      propertyPath: steps.Array.data[3].audioClip
