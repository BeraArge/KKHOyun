  popupCanvasGroup: {fileID: 1097455531}
  popupRect: {fileID: 1097455534}
  messageText: {fileID: 1048376431}
  messageCanvasGroup: {fileID: 1048376428}
  audioSource: {fileID: 1968639477}
  steps:
  - id: asama4_egitim1
    message: "Ameliyat sonras\u0131 ilk saatlerde doktorun izin verene kadar bir
      \u015Fey yiyip i\xE7memelisin.\r\nSa\u011Fl\u0131kl\u0131 beslenmek kalbini
      korur.\r\nDengeli beslenmek \xE7ok \xF6nemlidir.\r\nYa\u011Fl\u0131 ve fazla
      tuzlu yiyeceklerden uzak durmal\u0131s\u0131n.\r\nSebze ve meyve t\xFCketmelisin.\r\nYemeklere
      \xF6nce az miktarda ba\u015Flamal\u0131, sonra yava\u015F yava\u015F art\u0131rmal\u0131s\u0131n.\r\nFast
      food ve gazl\u0131 i\xE7ecekler sa\u011Fl\u0131kl\u0131 de\u011Fildir.\r\n\xC7ay
      ve kola gibi kafeinli i\xE7ecekler \xF6nerilmez."
    audioClip: {fileID: 8300000, guid: 5110c30160b4b1748b6902214d14c331, type: 3}
  nurseImage: {fileID: 1842235024}
  nurseFrames:
  - {fileID: 21300000, guid: 41ca08a768475f541a6220012f989d3d, type: 3}
